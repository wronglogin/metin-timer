      "bans": {
        ".read": "auth != null && auth.token.auth_time * 1000 > now - 604800000 && (!root.child('config/authepoch').exists() || auth.token.auth_time * 1000 > root.child('config/authepoch').val())",
        "$id": {
          ".validate": "$id.matches(/^[a-z0-9]{6,24}$/) && newData.hasChildren(['n', 'at'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "nickreset": {
        "$k": {
          ".validate": "$k.matches(/^u[0-9a-z]{7}$/) && newData.isNumber()"
        }
      },
      "nickchange": {
        ".read": "auth != null && auth.token.auth_time * 1000 > now - 604800000 && (!root.child('config/authepoch').exists() || auth.token.auth_time * 1000 > root.child('config/authepoch').val())",
        "$k": {
          ".validate": "$k.matches(/^u[0-9a-z]{7}$/) && newData.isNumber()"
        }
      },
      "acctepoch": {
        ".read": true,
        ".validate": "newData.isNumber()"
      },
      "roombans": {
        ".read": "auth != null && auth.token.auth_time * 1000 > now - 604800000 && (!root.child('config/authepoch').exists() || auth.token.auth_time * 1000 > root.child('config/authepoch').val())",
        "$room": {
          ".validate": "$room.matches(/^[A-Za-z0-9_-]{3,40}$/) && newData.isNumber()"
        }
      },
      "alog": {
        ".read": "auth != null && auth.token.auth_time * 1000 > now - 604800000 && (!root.child('config/authepoch').exists() || auth.token.auth_time * 1000 > root.child('config/authepoch').val())",
        "$k": {
          ".validate": "$k.matches(/^[0-9]{14}-[a-z0-9]{1,24}$/) && newData.hasChildren(['s', 'at'])",
          "s": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      },
      "reload": {
        ".read": true,
        ".validate": "newData.isNumber()"
      },
      "authepoch": {
        ".read": true,
        ".validate": "newData.isNumber()"
      }
    },
    "authpending": {
      "$s": {
        ".read": true,
        ".write": true,
        ".validate": "$s.matches(/^[A-Za-z0-9_-]{16,64}$/) && (!newData.exists() || (newData.hasChildren(['ct']) && newData.child('ct').isString() && newData.child('ct').val().length < 4000))"
      }
    }
  }
}
